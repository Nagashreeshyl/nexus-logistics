rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inOrg(orgId) {
      return signedIn() && userDoc().organizationId == orgId;
    }

    function hasRole(role) {
      return signedIn() && role in userDoc().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDispatcher() {
      return hasRole('dispatcher') || isAdmin();
    }

    function isAnalyst() {
      return hasRole('analyst') || isAdmin() || isDispatcher();
    }

    function isDriver() {
      return hasRole('driver') || isAdmin();
    }

    match /organizations/{orgId} {
      allow read: if inOrg(orgId);
      allow write: if inOrg(orgId) && isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isDispatcher());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || (isDriver() && resource.data.userId == request.auth.uid));
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /vehicles/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isDriver());
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /customers/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin());
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /orders/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.assignedDriverUserId == request.auth.uid));
      allow create, update: if signedIn() && (
        (isDispatcher() && inOrg(request.resource.data.organizationId))
        || (isDriver() && resource.data.assignedDriverUserId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /routes/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /stops/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId);
      allow write: if signedIn() && (isDispatcher() || isDriver());
    }

    match /deliveries/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow write: if signedIn() && (
        isDispatcher()
        || (isDriver() && resource.data.driverUserId == request.auth.uid)
      );
    }

    match /exceptions/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin());
      allow write: if signedIn() && (isDispatcher() || isDriver());
    }

    match /optimizationRuns/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAnalyst();
      allow write: if signedIn() && isDispatcher();
    }

    match /auditLogs/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /scenarios/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId);
      allow write: if signedIn() && isDispatcher();
    }

    match /metrics/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAnalyst();
      allow write: if signedIn() && isDispatcher();
    }
  }
}
