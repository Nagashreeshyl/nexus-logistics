rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inOrg(orgId) {
      return signedIn() && userDoc().organizationId == orgId;
    }

    function hasRole(role) {
      return signedIn() && role in userDoc().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDispatcher() {
      return hasRole('dispatcher') || isAdmin();
    }

    function isAnalyst() {
      return hasRole('analyst') || isAdmin() || isDispatcher();
    }

    function isDriver() {
      return hasRole('driver') || isAdmin();
    }

    // Clients may change presentation fields only — never roles / org / status.
    function userSelfSafeUpdate() {
      return request.auth.uid == request.resource.data.uid
        || !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function noPrivilegeEscalation() {
      return request.resource.data.roles == resource.data.roles
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.status == resource.data.status
        && (
          !('driverId' in request.resource.data)
          || request.resource.data.driverId == resource.data.driverId
          || isAdmin()
        );
    }

    match /organizations/{orgId} {
      allow read: if inOrg(orgId);
      allow write: if inOrg(orgId) && isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isDispatcher());
      // Bootstrap empty shell — roles must be [].
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.roles.size() == 0
        && request.resource.data.email == request.auth.token.email;
      // Self: activeRole / displayName only. Admin: full.
      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && userSelfSafeUpdate()
          && noPrivilegeEscalation()
        )
      );
      allow delete: if isAdmin();
    }

    match /drivers/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || (isDriver() && resource.data.userId == request.auth.uid));
      allow create, update: if signedIn() && isDispatcher()
        && inOrg(request.resource.data.organizationId);
      allow delete: if isAdmin();
    }

    match /vehicles/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isDriver());
      allow create, update: if signedIn() && isDispatcher()
        && inOrg(request.resource.data.organizationId);
      allow delete: if isAdmin();
    }

    match /customers/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin());
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /orders/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.assignedDriverUserId == request.auth.uid));
      allow create: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
      allow update: if signedIn() && (
        (isDispatcher() && inOrg(request.resource.data.organizationId))
        || (isDriver() && resource.data.assignedDriverUserId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /routes/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow write: if signedIn() && isDispatcher() && inOrg(request.resource.data.organizationId);
    }

    match /stops/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow create, update: if signedIn() && (
        (isDispatcher() && inOrg(request.resource.data.organizationId))
        || (isDriver() && resource.data.driverUserId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /deliveries/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow create: if signedIn() && isDispatcher();
      allow update: if signedIn() && (
        isDispatcher()
        || (isDriver() && resource.data.driverUserId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /exceptions/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId)
        && (isDispatcher() || isAnalyst() || isAdmin()
            || (isDriver() && resource.data.driverUserId == request.auth.uid));
      allow create, update: if signedIn() && (
        isDispatcher()
        || (isDriver() && resource.data.driverUserId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /optimizationRuns/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAnalyst();
      allow write: if signedIn() && isDispatcher();
    }

    match /auditLogs/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /scenarios/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId);
      allow write: if signedIn() && isDispatcher();
    }

    match /metrics/{id} {
      allow read: if signedIn() && inOrg(resource.data.organizationId) && isAnalyst();
      allow write: if signedIn() && isDispatcher();
    }

    // In-app notifications (FCM later). Users read/update own docs only.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.organizationId is string;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
