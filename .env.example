# Copy to .env and adjust locally. Never commit real secrets.

# Travel matrix: omit for OSRM→haversine fallback, or force demo/offline:
# JP019_TRAVEL=haversine

# Optional Redis cache (falls back to in-memory TTL if unset/unavailable):
# REDIS_URL=redis://127.0.0.1:6379/0

# Future V2 placeholders (leave empty in V1):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
