# Copy to `.env` (backend) and `frontend/.env.local` (Vite). Never commit real secrets.

# --- Demo / travel ---
# JP019_TRAVEL=haversine
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Organization ---
NEXUS_ORG_ID=nexus-demo
NEXUS_ORG_NAME=Nexus Logistics Demo

# Comma-separated emails that receive all four roles after Auth accounts exist.
# Passwords are NEVER stored here — create users in Firebase Console / Auth UI.
NEXUS_DEMO_EMAILS=nagashreeshyl@gmail.com,skandachandrashekar335@gmail.com,nivethams07@gmail.com,ankithalokesh0@gmail.com

# --- Backend: Firebase Admin ---
# Prefer a service-account JSON path (gitignored). Or set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Optional inline JSON (avoid in shell history):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Frontend: Firebase Web SDK (Vite) ---
# Place these in frontend/.env.local (prefixed with VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional local emulators (start with: npm run firebase:emulators from frontend/)
# VITE_USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
