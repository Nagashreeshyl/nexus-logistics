{
  "name": "vertex-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:roles": "npx --yes tsx src/lib/roles.selftest.ts",
    "test:delivery": "npx --yes tsx src/lib/deliveryStatus.selftest.ts",
    "firebase:emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
